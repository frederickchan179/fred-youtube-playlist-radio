{
  "name": "fred-youtube-playlist-radio",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @radio/server --filter @radio/web dev",
    "dev:lando": "HOST=0.0.0.0 PORT=8787 pnpm --filter @radio/server exec tsx watch src/index.ts & pnpm --filter @radio/web exec vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* typecheck",
    "import": "pnpm --filter @radio/cli exec tsx src/index.ts import",
    "sync": "pnpm --filter @radio/cli exec tsx src/index.ts sync"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
